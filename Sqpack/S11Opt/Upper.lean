/-- A packing needs a container of side at least `1`. -/
lemma one_le_of_packs {n : ℕ} (hn : 0 < n) {s : ℝ} (h : Packs n s) : 1 ≤ s := by
  obtain ⟨ctr, ang, hin, -⟩ := h
  obtain ⟨h1, h2, -, -⟩ := (sq_subset_box_iff s _ _).mp (hin ⟨0, hn⟩)
  linarith [one_le_wid (ang ⟨0, hn⟩)]

/-- **`s(11) ≤ T`.** -/
theorem minSide_le_T : minSide 11 ≤ T :=
  csInf_le ⟨0, fun _ hs => by linarith [one_le_of_packs (by norm_num) hs]⟩ packs_T

/-- The numeric form: `s(11) < 3.87708359002281417731`. -/
theorem minSide_lt_U : minSide 11 < 387708359002281417731 / 10 ^ 20 :=
  lt_of_le_of_lt minSide_le_T T_lt_U

