def traceTargets (stage : ℕ) : List (ℕ × ℕ) :=
  (traceTargetTable[stage]?).getD []

/-- The original shared rule, with the same unique terminal stage. -/
def traceOptions (stage : ℕ) : List (List (List (ℕ × ℕ))) :=
  if stage = 17 then triOpts (traceTriangles stage)
  else stepOpts (traceTriangles stage) (traceTargets stage)

