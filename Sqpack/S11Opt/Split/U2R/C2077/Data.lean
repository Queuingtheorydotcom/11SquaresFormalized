def traceOptions (stage : ℕ) : List (List (List (ℕ × ℕ))) :=
  if stage = 15 then triOpts (traceTriangles stage)
  else stepOpts (traceTriangles stage) (traceTargets stage)

end SquarePacking.S11Opt.Split.U2R.C2077
