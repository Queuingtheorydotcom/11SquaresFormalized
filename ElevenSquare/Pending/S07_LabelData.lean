def overlayLabels (r : Fin 220) : Fin 4 → Fin 16 := recordedOverlayLabels[r.val]!

def view (g : Fin 4) (p : Point) : Point :=
  (![p, (1-p.1,p.2), (1-p.2,p.1), (p.2,p.1)] : Fin 4 → Point) g

def halfTurn (p : Point) : Point := (1-p.1,1-p.2)

def halfTurnMask (m : Finset (Fin 16)) : Finset (Fin 16) :=
  m.image (fun j => ⟨15-j.val, by omega⟩)

def otherCandidateMasks : Finset (Finset (Fin 16)) :=
  { {0,1,2,4,6,7,9,10,12,14,15}, {0,1,3,5,6,8,9,11,12,13,14},
    {0,2,3,4,5,6,7,11,12,13,14} }

def otherRawMasks : Finset (Finset (Fin 16)) :=
  otherCandidateMasks ∪ otherCandidateMasks.image halfTurnMask

end
