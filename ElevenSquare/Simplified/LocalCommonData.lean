def matrixInteger (i : Fin 40) (k : Fin 33) : ℤ :=
  roundedGradients (rowIndex i) k

def radiusQ (k : Fin 33) : ℚ := (radiusNumerators k : ℚ)/10000000000

def curvatureQ (i : Fin 40) : ℚ := (curvatureNumerator i : ℚ)/1000000000000

def matrixQ (i : Fin 40) (k : Fin 33) : ℚ := (matrixInteger i k : ℚ)/1000000000000

def weight (j : Fin 33) (s : Fin 2) (i : Fin 40) : ℚ :=
  (dualNumerator j s i : ℚ)/1000

def signInteger (s : Fin 2) : ℤ := if s=0 then -1 else 1

def residualQ (j : Fin 33) (s : Fin 2) : ℚ :=
  ∑ k, radiusQ k *
    (|(∑ i, weight j s i*matrixQ i k)-(if k=j then (signInteger s : ℚ) else 0)| +
      (1/1000000000000)*(∑ i, weight j s i))

