import ElevenSquare.Simplified.InventoryTree

/-! Published T04 closed-prefix certificates, interpreted by one shared checker.
Each line is one accepted row, one exact refutation, or one branch reference. -/
namespace ElevenSquare.Simplified.InventoryTree
set_option maxRecDepth 10000
set_option maxHeartbeats 2000000

theorem checked_branch {depth : ℕ} {labels : Fin 4 → Fin 16}
    {children : Fin 16 → Tree} (hd : depth < 4)
    (h : ∀ i, check (depth + 1) (Function.update labels ⟨depth, hd⟩ i)
      (children i) = true) : check depth labels (.branch children) = true := by
  rw [check, dif_pos hd]
  exact List.all_eq_true.mpr (fun i _ => h i)

