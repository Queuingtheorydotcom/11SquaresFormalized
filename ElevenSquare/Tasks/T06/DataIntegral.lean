def integerResidualCheck (b : Fin 128) (j : Fin 33) (s : Fin 2)
    (nums : Fin 42 → ℕ) : Prop :=
  (∑ k : Fin 33, |(∑ i : Fin 42, (nums i : ℤ) * roundedGradients (branchRows b i) k) -
      (if k = j then (![-1, 1] : Fin 2 → ℤ) s * 1000000000000000000000000 else 0)|) +
      33 * (∑ i : Fin 42, (nums i : ℤ)) ≤ (residualNumerators b j s : ℤ)

def integerMassCheck (b : Fin 128) (j : Fin 33) (s : Fin 2)
    (nums : Fin 42 → ℕ) : Prop :=
  (∑ i : Fin 42, nums i * curvatureNumerators (branchRows b i)) * 10000000000 +
    2 * residualNumerators b j s * 67647473 <
    2 * radiusNumerators j * 1000000000000000000000000

instance (b : Fin 128) (j : Fin 33) (s : Fin 2) (nums : Fin 42 → ℕ) :
    Decidable (integerResidualCheck b j s nums) := by
  unfold integerResidualCheck
  infer_instance

instance (b : Fin 128) (j : Fin 33) (s : Fin 2) (nums : Fin 42 → ℕ) :
    Decidable (integerMassCheck b j s nums) := by
  unfold integerMassCheck
  infer_instance

