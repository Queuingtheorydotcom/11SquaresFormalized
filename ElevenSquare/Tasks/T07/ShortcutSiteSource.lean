import ElevenSquare.Tasks.T07.ShortcutSiteSeed
import ElevenSquare.Tasks.T07.CoordinateBridge
import Mathlib.Tactic.NormNum

/-! Exact identification of the eleven first owned points in the archived
`mask438-adaptive.json` seed wall replay. The archived points are in field
coordinates, whereas `physicalSite` is in physical unit-square coordinates.
The finite equalities are recomputed by Lean rather than assumed from JSON. -/
namespace ElevenSquare.Tasks.T07
open ElevenSquare.Pending
noncomputable section

/-- First seed wall point for each ascending case-438 owner, in field coordinates. -/
def sourceFirstSite : Owner → QPoint :=
  ![(15319496569121628910838125411/19385417950114070886550000000, 33708353663129091681862966777/38770835900228141773100000000),
    (15029153492153280532534265221/9692708975057035443275000000, 12050494350799034968043615363/19385417950114070886550000000),
    (88737913161541469134089955903/38770835900228141773100000000, 4293740215697156759037095869/4846354487528517721637500000),
    (114229184494171325208987705383/38770835900228141773100000000, 3799828974131068230966946321/4846354487528517721637500000),
    (30430119458982832532936304401/38770835900228141773100000000, 31551745548174116464196529359/19385417950114070886550000000),
    (7773252253124983998668828381/9692708975057035443275000000, 23032186155339625534094601177/9692708975057035443275000000),
    (29593465507625704049164503403/19385417950114070886550000000, 16656361907951066461997586011/7754167180045628354620000000),
    (88212898920117079971074578869/38770835900228141773100000000, 47305909547072512985711330607/19385417950114070886550000000),
    (117674473679888669040305695599/38770835900228141773100000000, 42500551021261634322424470641/19385417950114070886550000000),
    (59366679977330032439152044097/38770835900228141773100000000, 14219333926661780937618154131/4846354487528517721637500000),
    (58732800000314121875782874589/19385417950114070886550000000, 114396239475742409891379033223/38770835900228141773100000000)]

theorem sourceFirstSite_eq_scaled (i : Owner) :
    sourceFirstSite i =
      (seedFieldScale * (physicalSite (ownerCell i)).1,
       seedFieldScale * (physicalSite (ownerCell i)).2) := by
  fin_cases i <;> norm_num [sourceFirstSite, seedFieldScale, physicalSite,
    ownerCell, seedCap, seedSite]

theorem sourceFirstSite_cast (i : Owner) :
    realPoint (sourceFirstSite i) =
      toField (realPoint (physicalSite (ownerCell i))) := by
  rw [sourceFirstSite_eq_scaled]
  apply Prod.ext
  · dsimp [realPoint, toField]
    push_cast
    rw [seedFieldScale_cast]
  · dsimp [realPoint, toField]
    push_cast
    rw [seedFieldScale_cast]

end
end ElevenSquare.Tasks.T07
