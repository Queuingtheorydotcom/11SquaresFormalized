theorem pcov_ok : ∀ j, pcov j ≠ [] → pcovB prev j (pcov j) = true := by
  intro j hj
  by_cases h7 : j = 7
  · subst h7; exact pc7_ok
  by_cases h8 : j = 8
  · subst h8; exact pc8_ok
  by_cases h0 : j = 0
  · subst h0; exact pc0_ok
  simp [pcov, h7, h8, h0] at hj

