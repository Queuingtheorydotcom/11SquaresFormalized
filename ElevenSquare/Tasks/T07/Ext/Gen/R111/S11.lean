theorem pcov_ok : ∀ j, pcov j ≠ [] → pcovB prev j (pcov j) = true := by
  intro j hj
  by_cases h5 : j = 5
  · subst h5; exact pc5_ok
  by_cases h0 : j = 0
  · subst h0; exact pc0_ok
  by_cases h7 : j = 7
  · subst h7; exact pc7_ok
  simp [pcov, h5, h0, h7] at hj

