namespace ElevenSquare.Tasks.T07.Ext.R111.S12
open ElevenSquare ElevenSquare.Pending ElevenSquare.Tasks.T07 ElevenSquare.Tasks.T07.Ext

set_option maxRecDepth 100000
set_option maxHeartbeats 0

theorem pc6_ok : pcovB prev 6 pc6 = true := by native_decide

theorem pc9_ok : pcovB prev 9 pc9 = true := by native_decide

theorem pc1_ok : pcovB prev 1 pc1 = true := by native_decide

theorem pcov_ok : ∀ j, pcov j ≠ [] → pcovB prev j (pcov j) = true := by
  intro j hj
  by_cases h6 : j = 6
  · subst h6; exact pc6_ok
  by_cases h9 : j = 9
  · subst h9; exact pc9_ok
  by_cases h1 : j = 1
  · subst h1; exact pc1_ok
  simp [pcov, h6, h9, h1] at hj

end ElevenSquare.Tasks.T07.Ext.R111.S12
namespace ElevenSquare.Tasks.T07.Ext.R111.S12
open ElevenSquare.Simplified.U5RowBlocks
open ElevenSquare ElevenSquare.Pending ElevenSquare.Tasks.T07 ElevenSquare.Tasks.T07.Ext

set_option maxRecDepth 100000
set_option maxHeartbeats 0

def certs : List (List Sub) := [cert0, cert1, cert2, cert3, cert4, cert5, cert6, cert7, cert8, cert9, cert10, cert11, cert12, cert13, cert14, cert15, cert16, cert17, cert18, cert19, cert20, cert21, cert22, cert23, cert24, cert25, cert26, cert27, cert28, cert29, cert30, cert31, cert32, cert33, cert34]

theorem nrows : (prev.rows 7).length = 35 := by decide +kernel

theorem step_ok : stepB prev 7 rs pcov certs = true := by
  apply stepB_of_row_blocks (width := 8) (blocks := 5) (by decide)
    (by rw [nrows]; rfl) (by rw [nrows]; decide)
  intro b hb
  interval_cases b <;> native_decide

theorem prune : ExtStep prev mid := stepB_sound pcov_ok step_ok

theorem promote_ok : promoteB mid 7 kern prs combs = true := by native_decide

theorem trace : ExtTrace prev next :=
  ExtTrace.cons prune (ExtTrace.cons (ExtStep.base (promoteB_sound promote_ok)) (ExtTrace.refl _))

end ElevenSquare.Tasks.T07.Ext.R111.S12
