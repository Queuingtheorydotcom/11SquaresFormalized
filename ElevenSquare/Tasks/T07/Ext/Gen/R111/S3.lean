def certs : List (List Sub) := [cert0, cert1, cert2, cert3, cert4, cert5, cert6, cert7, cert8, cert9, cert10, cert11, cert12, cert13, cert14, cert15, cert16, cert17, cert18, cert19, cert20, cert21, cert22, cert23, cert24, cert25, cert26, cert27, cert28, cert29, cert30, cert31, cert32, cert33, cert34, cert35, cert36, cert37, cert38, cert39, cert40, cert41, cert42, cert43, cert44, cert45, cert46, cert47, cert48, cert49, cert50, cert51, cert52]

theorem nrows : (prev.rows 5).length = 53 := by decide +kernel

theorem step_ok : stepB prev 5 rs pcov certs = true := by
  apply stepB_of_row_blocks (width := 8) (blocks := 7) (by decide)
    (by rw [nrows]; rfl) (by rw [nrows]; decide)
  intro b hb
  interval_cases b <;> native_decide

theorem prune : ExtStep prev mid := stepB_sound pcov_ok step_ok

