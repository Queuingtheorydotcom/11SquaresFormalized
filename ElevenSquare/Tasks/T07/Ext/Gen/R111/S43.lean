  intro j hj
  by_cases h4 : j = 4
  · subst h4; exact pc4_ok
  by_cases h8 : j = 8
  · subst h8; exact pc8_ok
  by_cases h10 : j = 10
  · subst h10; exact pc10_ok
  simp [pcov, h4, h8, h10] at hj

