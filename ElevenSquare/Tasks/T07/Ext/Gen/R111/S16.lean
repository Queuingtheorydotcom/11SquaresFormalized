theorem pc1_ok : pcovB prev 1 pc1 = true := by decide +kernel

theorem pcov_ok : ∀ j, pcov j ≠ [] → pcovB prev j (pcov j) = true := by
  intro j hj
  by_cases h7 : j = 7
  · subst h7; exact pc7_ok
  by_cases h10 : j = 10
  · subst h10; exact pc10_ok
  by_cases h1 : j = 1
  · subst h1; exact pc1_ok
  simp [pcov, h7, h10, h1] at hj

