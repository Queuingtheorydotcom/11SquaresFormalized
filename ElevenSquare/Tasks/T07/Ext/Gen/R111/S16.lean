set_option maxHeartbeats 0

def certs : List (List Sub) := [cert0, cert1, cert2, cert3, cert4, cert5, cert6, cert7, cert8, cert9, cert10, cert11, cert12, cert13, cert14, cert15, cert16, cert17, cert18, cert19, cert20, cert21, cert22, cert23, cert24, cert25, cert26]

theorem nrows : (prev.rows 9).length = 27 := by decide +kernel

theorem step_ok : stepB prev 9 rs pcov certs = true := by
  apply stepB_of_row_blocks (width := 8) (blocks := 4) (by decide)
    (by rw [nrows]; rfl) (by rw [nrows]; decide)
  intro b hb
  interval_cases b <;> decide +kernel

