  intro j hj
  by_cases h6 : j = 6
  · subst h6; exact pc6_ok
  by_cases h7 : j = 7
  · subst h7; exact pc7_ok
  by_cases h5 : j = 5
  · subst h5; exact pc5_ok
  simp [pcov, h6, h7, h5] at hj

