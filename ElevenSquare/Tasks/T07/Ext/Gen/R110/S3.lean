theorem step_ok : stepB prev 5 rs pcov certs = true := by
  apply stepB_of_row_blocks (width := 8) (blocks := 7) (by decide)
    (by rw [nrows]; rfl) (by rw [nrows]; decide)
  intro b hb
  interval_cases b <;> native_decide

