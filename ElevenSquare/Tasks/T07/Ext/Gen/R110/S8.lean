theorem pcov_ok : ∀ j, pcov j ≠ [] → pcovB prev j (pcov j) = true := by
  intro j hj
  by_cases h9 : j = 9
  · subst h9; exact pc9_ok
  by_cases h7 : j = 7
  · subst h7; exact pc7_ok
  by_cases h10 : j = 10
  · subst h10; exact pc10_ok
  simp [pcov, h9, h7, h10] at hj

