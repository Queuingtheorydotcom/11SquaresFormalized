theorem pc3_ok : pcovB prev 3 pc3 = true := by native_decide

theorem pc8_ok : pcovB prev 8 pc8 = true := by native_decide

theorem pcov_ok : ∀ j, pcov j ≠ [] → pcovB prev j (pcov j) = true := by
  intro j hj
  by_cases h2 : j = 2
  · subst h2; exact pc2_ok
  by_cases h3 : j = 3
  · subst h3; exact pc3_ok
  by_cases h8 : j = 8
  · subst h8; exact pc8_ok
  simp [pcov, h2, h3, h8] at hj

