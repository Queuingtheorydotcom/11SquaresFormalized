  intro j hj
  by_cases h10 : j = 10
  · subst h10; exact pc10_ok
  by_cases h7 : j = 7
  · subst h7; exact pc7_ok
  by_cases h8 : j = 8
  · subst h8; exact pc8_ok
  simp [pcov, h10, h7, h8] at hj

