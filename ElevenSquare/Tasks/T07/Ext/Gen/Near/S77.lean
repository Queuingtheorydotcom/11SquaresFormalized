namespace ElevenSquare.Tasks.T07.Ext.Near.S77
open ElevenSquare ElevenSquare.Pending ElevenSquare.Tasks.T07 ElevenSquare.Tasks.T07.Ext

set_option maxRecDepth 100000
set_option maxHeartbeats 0

theorem pc9_ok : pcovB prev 9 pc9 = true := by native_decide

theorem pc8_ok : pcovB prev 8 pc8 = true := by native_decide

theorem pc2_ok : pcovB prev 2 pc2 = true := by native_decide

theorem pcov_ok : ∀ j, pcov j ≠ [] → pcovB prev j (pcov j) = true := by
  intro j hj
  by_cases h9 : j = 9
  · subst h9; exact pc9_ok
  by_cases h8 : j = 8
  · subst h8; exact pc8_ok
  by_cases h2 : j = 2
  · subst h2; exact pc2_ok
  simp [pcov, h9, h8, h2] at hj

end ElevenSquare.Tasks.T07.Ext.Near.S77
namespace ElevenSquare.Tasks.T07.Ext.Near.S77
open ElevenSquare.Simplified.U5RowBlocks
open ElevenSquare ElevenSquare.Pending ElevenSquare.Tasks.T07 ElevenSquare.Tasks.T07.Ext

set_option maxRecDepth 100000
set_option maxHeartbeats 0

def certs : List (List Sub) := [cert0, cert1, cert2, cert3, cert4, cert5, cert6, cert7, cert8, cert9, cert10, cert11, cert12, cert13, cert14, cert15, cert16]

theorem nrows : (prev.rows 10).length = 17 := by decide +kernel

theorem step_ok : stepB prev 10 rs pcov certs = true := by
  apply stepB_of_row_blocks (width := 8) (blocks := 3) (by decide)
    (by rw [nrows]; rfl) (by rw [nrows]; decide)
  intro b hb
  interval_cases b <;> native_decide

theorem prune : ExtStep prev mid := stepB_sound pcov_ok step_ok

theorem promote_ok : promoteB mid 10 kern prs combs = true := by native_decide

theorem trace : ExtTrace prev next :=
  ExtTrace.cons prune (ExtTrace.cons (ExtStep.base (promoteB_sound promote_ok)) (ExtTrace.refl _))

end ElevenSquare.Tasks.T07.Ext.Near.S77
