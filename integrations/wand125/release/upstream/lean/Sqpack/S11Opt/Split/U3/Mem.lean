lemma combo_ok : (List.range 16).all (fun a0 => (nbL 0 a0).all fun a1 => (nbL 1 a0).all fun a2 =>
    (nbL 2 a0).all fun a3 => !((nbL 3 a1).contains a2 && (nbL 4 a1).contains a3 &&
      (nbL 5 a2).contains a3) || regs.contains [a0, a1, a2, a3] ||
        fakes.contains [a0, a1, a2, a3]) = true := by
  decide +kernel

/-- **Every centre lies in one of the 220 regions**: its four view labels form a listed tuple. -/
theorem tuple_mem {p : ℝ × ℝ} (hp : InB p) {a0 a1 a2 a3 : ℕ} (h016 : a0 < 16) (h116 : a1 < 16)
    (h216 : a2 < 16) (h316 : a3 < 16) (h0 : InCellU a0 (vw 0 p)) (h1 : InCellU a1 (vw 1 p))
    (h2 : InCellU a2 (vw 2 p)) (h3 : InCellU a3 (vw 3 p)) : [a0, a1, a2, a3] ∈ regs := by
  have m01 := pair01 hp h016 h116 h0 h1
  have m02 := pair02 hp h016 h216 h0 h2
  have m03 := pair03 hp h016 h316 h0 h3
  have m12 := pair12 hp h116 h216 h1 h2
  have m13 := pair13 hp h116 h316 h1 h3
  have m23 := pair23 hp h216 h316 h2 h3
  have := List.all_eq_true.mp (List.all_eq_true.mp (List.all_eq_true.mp (List.all_eq_true.mp
    combo_ok a0 (List.mem_range.mpr h016)) a1 m01) a2 m02) a3 m03
  have k1 : (nbL 3 a1).contains a2 = true := by simpa using m12
  have k2 : (nbL 4 a1).contains a3 = true := by simpa using m13
  have k3 : (nbL 5 a2).contains a3 = true := by simpa using m23
  rw [k1, k2, k3] at this
  simp only [Bool.and_self, Bool.not_true, Bool.false_or, Bool.or_eq_true] at this
  rcases this with h | h
  · simpa using h
  · exact (not_fake hp h0 h1 h2 h3 (by simpa using h)).elim

