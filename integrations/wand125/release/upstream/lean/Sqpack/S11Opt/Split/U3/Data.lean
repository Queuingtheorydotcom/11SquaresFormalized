lemma domT_eq : domT = (List.range 16).map fun o =>
    ((List.range 220).filter fun r => lab r 0 == o).map fun r => (r, regs.getD r [], compatM.getD r 0) := by
  decide +kernel

/-- Some view has equal labels. -/
def sameAny (t t' : List ℕ) : Bool := (List.range 4).any fun g => t.getD g 0 == t'.getD g 0

lemma compatM_ok : (List.range 220).all (fun r => (List.range 220).all fun s =>
    (compatM.getD r 0).testBit s || sameAny (regs.getD r []) (regs.getD s []) ||
      banL.contains (r, s) || banL.contains (s, r)) = true := by
  decide +kernel

end SquarePacking.S11Opt.Split
