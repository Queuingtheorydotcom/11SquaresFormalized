  unfold Ux at hx1 hy1
  have g0 := cell_lin h 1 (80206788320008528328995421 / 100000000000000000000000000 : ℝ) (176483527032089485245355847 / 200000000000000000000000000 : ℝ) (78686667498184714830022331 / 50000000000000000000000000 : ℝ) (63091593459680811351013693 / 100000000000000000000000000 : ℝ) rfl rfl
  have g3 := cell_lin h 4 (80206788320008528328995421 / 100000000000000000000000000 : ℝ) (176483527032089485245355847 / 200000000000000000000000000 : ℝ) (159319997167449384989195311 / 200000000000000000000000000 : ℝ) (165192385068974431749720049 / 100000000000000000000000000 : ℝ) rfl rfl
  have g4 := cell_lin h 5 (80206788320008528328995421 / 100000000000000000000000000 : ℝ) (176483527032089485245355847 / 200000000000000000000000000 : ℝ) (313569079679342521477316341 / 200000000000000000000000000 : ℝ) (140033439907660930894815023 / 100000000000000000000000000 : ℝ) rfl rfl
