  have g15 : 0 ≤ (-1 / 2 : ℝ) + (1 : ℝ) * p.1 + (0 : ℝ) * p.2 := by linarith
  have g17 : 0 ≤ (-1 / 2 : ℝ) + (0 : ℝ) * p.1 + (1 : ℝ) * p.2 := by linarith
  rcases le_total 0 ((-106497 / 125000 : ℝ) + (769 / 1000 : ℝ) * p.1 + (3 / 500 : ℝ) * p.2) with s0 | s0
  · linarith [mul_nonneg g0 g3, mul_nonneg g0 g15, mul_nonneg g0 s0, mul_nonneg g3 g17, mul_nonneg g4 g17]
  · replace s0 : 0 ≤ (106497 / 125000 : ℝ) + (-769 / 1000 : ℝ) * p.1 + (-3 / 500 : ℝ) * p.2 := by linarith
    linarith [mul_nonneg g3 g17, mul_nonneg g7 g17, mul_nonneg g15 g17, mul_nonneg g15 s0]

