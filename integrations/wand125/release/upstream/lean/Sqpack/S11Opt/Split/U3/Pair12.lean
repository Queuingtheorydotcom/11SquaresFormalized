import Sqpack.S11Opt.Split.U3.Data

/-!
# U3 — empty pairwise overlays, views 1 and 2

Generated by `scripts/u1u3/u3gen.py`.  A point of `[1/2, Ux − 1/2]²` in the cell `a` of view 1 and
the cell `b` of view 2: `b` is one of the listed partners of `a`.  Every other pair is empty, by
a Farkas certificate of at most three of the defining half-planes (`linarith`).
-/

set_option linter.style.longLine false

namespace SquarePacking.S11Opt.Split

